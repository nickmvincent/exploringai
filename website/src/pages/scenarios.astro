---
import NapkinApp from '../components/NapkinApp.vue';
import Layout from '../layouts/Layout.astro';
import { loadNapkinData } from '../lib/napkin-data';

const { inputs, scenarios } = await loadNapkinData();
---

<Layout
  title="Browse estimates - Exploring AI: Data Napkin Math"
  description="Browse editable, source-backed estimates about AI data, labor, compensation, and scale."
>
  <NapkinApp
    client:load
    initialInputs={inputs}
    initialScenarios={scenarios}
    showInputLibrary={false}
    showCustomBuilder={false}
    pageEyebrow="Estimate library"
    pageTitle="Questions you can calculate—and challenge."
    pageDescription="Open a public question, try another benchmark case, or inspect the assumptions behind the answer."
  />
</Layout>
