---
const targetPath = '/research';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to research</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
    <script is:inline>window.location.replace(new URL('/research', window.location.origin).toString());</script>
  </head>
  <body><a href={targetPath}>Continue to research</a></body>
</html>
